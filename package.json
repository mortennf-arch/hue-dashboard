{
  "name": "hue-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalt dashbord for Philips Hue",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "pair": "tsx src/main.ts pair",
    "watch": "tsx src/main.ts watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
